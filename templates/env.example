# intervals.icu Settings -> Developer -> API Key
INTERVALS_API_KEY=your_api_key_here
# From the URL when logged in, e.g. https://intervals.icu/athlete/i123456/...
INTERVALS_ATHLETE_ID=i123456
# Optional — target placement on the watch: 'all' (default; pace/HR on every step)
# or 'hard-only' (targets on hard efforts only; easy work runs by feel, guidance in prose).
# ROBO_COACH_TARGETS=all
